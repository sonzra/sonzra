<main class="settings-shell detail-page <%= "redesign-discovery-detail redesign-detail-page" if redesign_enabled? %>">
  <% first_track = @tracks.first %>
  <% artwork_path = first_track&.artwork_item_id.present? ? artwork_server_connection_path(@collection.server_connection, first_track.artwork_item_id) : "/brand/sonzra-mark.svg" %>
  <% if redesign_enabled? %>
    <div class="redesign-detail-ambient" aria-hidden="true"></div>
    <%= link_to @back_path, class: "detail-back-link redesign-detail-back", aria: { label: "Go back" }, data: { controller: "history-back", action: "click->history-back#go" } do %><%= lucide_icon "arrow-left", aria: { hidden: true } %><span>Back</span><% end %>
  <% end %>
  <section class="detail-hero <%= "redesign-detail-hero" if redesign_enabled? %>">
    <div class="detail-hero__art" data-media-header-target="artwork"><%= image_tag artwork_path, alt: "" %><button type="button" class="detail-hero__album-play" aria-label="Play <%= @collection.title %>" data-action="player#replaceQueue" data-player-queue-url-param="<%= recommendation_collection_path(@collection) %>" data-player-radio-enabled-param="true" data-player-recommendation-collection-id-param="<%= @collection.id %>"><%= lucide_icon "play", aria: { hidden: true } %></button></div>
    <div>
      <p class="detail-hero__kind">Mix</p>
      <div class="detail-hero__title"><h1><%= @collection.title %></h1></div>
      <p class="detail-hero__release"><%= pluralize(@tracks.size, "track") %> · Generated <%= @collection.generated_at.to_date.to_fs(:long) %></p>
      <% if redesign_enabled? %>
        <div class="redesign-detail-actions">
          <button type="button" class="primary-button redesign-detail-action--play" aria-label="Play <%= @collection.title %>" data-action="player#replaceQueue" data-player-queue-url-param="<%= recommendation_collection_path(@collection) %>" data-player-radio-enabled-param="true" data-player-recommendation-collection-id-param="<%= @collection.id %>"><%= lucide_icon "play", aria: { hidden: true } %><span>Play</span></button>
          <button type="button" class="secondary-button redesign-detail-action--queue" aria-label="Add <%= @collection.title %> to queue" data-action="player#appendQueue" data-player-queue-url-param="<%= recommendation_collection_path(@collection) %>"><%= lucide_icon "list-plus", aria: { hidden: true } %><span>Add to queue</span></button>
        </div>
      <% end %>
    </div>
  </section>
  <section class="detail-section <%= "redesign-detail-tracks" if redesign_enabled? %>">
    <% if redesign_enabled? %><div class="redesign-detail-tracks__heading" aria-hidden="true"><span>Track</span><span>Duration</span><span>Actions</span></div><% end %>
    <h2>Tracks</h2>
    <ol class="track-list track-list--mixed">
      <% @tracks.each_with_index do |track, index| %>
        <% track_artwork_path = track.artwork_item_id.present? ? artwork_server_connection_path(@collection.server_connection, track.artwork_item_id) : "/brand/sonzra-mark.svg" %>
        <li>
          <span><%= index + 1 %></span>
          <strong data-artist="<%= track.artist || "Unknown artist" %>"><%= track.title %></strong>
          <time><%= track.duration %></time>
          <button type="button" class="listen-card__play" aria-label="Play <%= track.title %>" data-action="player#replaceQueue" data-player-source-param="<%= audio_server_connection_path(@collection.server_connection, track.item_id) %>" data-player-item-id-param="<%= track.item_id %>" data-player-reporting-url-param="<%= playback_reports_server_connection_path(@collection.server_connection) %>" data-player-title-param="<%= track.title %>" data-player-artist-param="<%= track.artist || "Unknown artist" %>" data-player-artwork-param="<%= track_artwork_path %>" data-player-radio-url-param="<%= radio_tracks_server_connection_path(@collection.server_connection, track.item_id) %>" data-player-radio-eligible-param="true"><%= lucide_icon "play", aria: { hidden: true } %></button>
          <button type="button" class="track-list__queue" aria-label="Add <%= track.title %> to queue" data-action="player#appendQueue" data-player-source-param="<%= audio_server_connection_path(@collection.server_connection, track.item_id) %>" data-player-item-id-param="<%= track.item_id %>" data-player-reporting-url-param="<%= playback_reports_server_connection_path(@collection.server_connection) %>" data-player-title-param="<%= track.title %>" data-player-artist-param="<%= track.artist || "Unknown artist" %>" data-player-artwork-param="<%= track_artwork_path %>" data-player-radio-url-param="<%= radio_tracks_server_connection_path(@collection.server_connection, track.item_id) %>" data-player-radio-eligible-param="true"><%= lucide_icon "plus", aria: { hidden: true } %></button>
          <% if redesign_enabled? %>
            <div class="detail-track__menu" data-controller="detail-menu">
              <button type="button" class="detail-track__more" aria-label="More actions for <%= track.title %>" aria-expanded="false" data-detail-menu-target="toggle" data-action="detail-menu#toggle"><%= lucide_icon "ellipsis", aria: { hidden: true } %></button>
              <div class="detail-track__menu-panel" data-detail-menu-target="menu" hidden>
                <button type="button" data-action="offline-media#download" data-offline-media-source="<%= audio_server_connection_path(@collection.server_connection, track.item_id) %>" data-offline-media-title="<%= track.title %>" data-offline-media-artist="<%= track.artist || "Unknown artist" %>" data-offline-media-artwork="<%= track_artwork_path %>" data-offline-media-duration="<%= track.duration %>" data-offline-media-item-id="<%= track.item_id %>" data-offline-media-album-id="<%= track.album_id %>" data-offline-media-album="<%= track.album %>" data-offline-media-album-artist="<%= track.album_artist %>" data-offline-media-reporting-url="<%= playback_reports_server_connection_path(@collection.server_connection) %>"><%= lucide_icon "download", aria: { hidden: true } %><span>Download</span></button>
              </div>
            </div>
          <% else %>
            <button type="button" class="track-list__download" aria-label="Download <%= track.title %> for offline playback" data-action="offline-media#download" data-offline-media-source="<%= audio_server_connection_path(@collection.server_connection, track.item_id) %>" data-offline-media-title="<%= track.title %>" data-offline-media-artist="<%= track.artist || "Unknown artist" %>" data-offline-media-artwork="<%= track_artwork_path %>" data-offline-media-duration="<%= track.duration %>" data-offline-media-item-id="<%= track.item_id %>" data-offline-media-album-id="<%= track.album_id %>" data-offline-media-album="<%= track.album %>" data-offline-media-album-artist="<%= track.album_artist %>" data-offline-media-reporting-url="<%= playback_reports_server_connection_path(@collection.server_connection) %>"><%= lucide_icon "download", aria: { hidden: true } %></button>
          <% end %>
        </li>
      <% end %>
    </ol>
  </section>
</main>
