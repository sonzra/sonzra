<main class="settings-shell detail-page">
  <% if @result.success? %>
    <% details = @result.details; item = details[:item]; album = details[:album]; kind = details.fetch(:kind, :music) %>
    <%= link_to @back_path, class: "detail-back-link" do %><%= lucide_icon "arrow-left", aria: { hidden: true } %><span><%= @back_label %></span><% end unless @media_detail_header %>
    <% if kind.in?([ :audiobook, :podcast ]) %>
      <% artwork_path = media_artwork_path(@server_connection, item); resume_position = playback_position(item) %>
      <section class="detail-hero detail-hero--longform">
        <div class="detail-hero__media">
          <div class="detail-hero__art" data-media-header-target="artwork"><%= image_tag artwork_path, alt: "" %></div>
          <div class="detail-hero__longform-actions" data-controller="longform-player">
            <% if resume_position.positive? %>
              <button type="button" class="detail-hero__longform-button detail-hero__longform-button--primary" aria-label="Continue <%= item["Name"] %> from <%= track_duration(item.dig("UserData", "PlaybackPositionTicks")) %>" data-action="player#replaceQueue" data-player-source-param="<%= audio_server_connection_path(@server_connection, item["Id"]) %>" data-player-item-id-param="<%= item["Id"] %>" data-player-reporting-url-param="<%= playback_reports_server_connection_path(@server_connection) %>" data-player-title-param="<%= item["Name"] %>" data-player-artist-param="<%= item["AlbumArtist"] || item["Artists"]&.join(", ") || (kind == :audiobook ? "Audiobook" : "Podcast") %>" data-player-artwork-param="<%= artwork_path %>" data-player-start-position-param="<%= resume_position %>"><%= lucide_icon "play", aria: { hidden: true } %> <span data-longform-player-target="primaryLabel">Continue</span></button>
            <% else %>
              <button type="button" class="detail-hero__longform-button detail-hero__longform-button--primary" aria-label="Play <%= item["Name"] %>" data-action="player#replaceQueue longform-player#markStarted" data-player-source-param="<%= audio_server_connection_path(@server_connection, item["Id"]) %>" data-player-item-id-param="<%= item["Id"] %>" data-player-reporting-url-param="<%= playback_reports_server_connection_path(@server_connection) %>" data-player-title-param="<%= item["Name"] %>" data-player-artist-param="<%= item["AlbumArtist"] || item["Artists"]&.join(", ") || (kind == :audiobook ? "Audiobook" : "Podcast") %>" data-player-artwork-param="<%= artwork_path %>" data-player-start-position-param="0"><%= lucide_icon "play", aria: { hidden: true } %> <span data-longform-player-target="primaryLabel">Play</span></button>
            <% end %>
            <button type="button" class="detail-hero__longform-button" aria-label="Play <%= item["Name"] %> from the beginning" data-longform-player-target="startOver" data-action="player#replaceQueue" data-player-source-param="<%= audio_server_connection_path(@server_connection, item["Id"]) %>" data-player-item-id-param="<%= item["Id"] %>" data-player-reporting-url-param="<%= playback_reports_server_connection_path(@server_connection) %>" data-player-title-param="<%= item["Name"] %>" data-player-artist-param="<%= item["AlbumArtist"] || item["Artists"]&.join(", ") || (kind == :audiobook ? "Audiobook" : "Podcast") %>" data-player-artwork-param="<%= artwork_path %>" data-player-start-position-param="0" <%= "hidden" unless resume_position.positive? %>><%= lucide_icon "rotate-ccw", aria: { hidden: true } %> Play from start</button>
          </div>
          <% if resume_position.positive? %><div class="detail-hero__progress" aria-label="<%= playback_progress(item) %>% complete"><span style="--progress:<%= playback_progress(item) %>%"></span><small><%= track_duration(item.dig("UserData", "PlaybackPositionTicks")) %> of <%= track_duration(item["RunTimeTicks"]) %></small></div><% end %>
        </div>
        <div>
          <p class="detail-hero__kind"><%= kind == :audiobook ? "Audiobook" : "Podcast episode" %></p>
          <% title_size = item["Name"].length > 48 ? "detail-hero__title--long" : item["Name"].length > 24 ? "detail-hero__title--compact" : "" %><div class="detail-hero__title <%= title_size %>"><h1><%= item["Name"] %></h1></div>
          <p><%= item["AlbumArtist"] || item["Artists"]&.join(", ") || item["Album"] %></p>
          <% if resume_position.positive? %><p class="detail-hero__resume">Continue from <%= track_duration(item.dig("UserData", "PlaybackPositionTicks")) %></p><% end %>
          <% if item["Overview"].present? %><p><%= item["Overview"] %></p><% end %>
          <dl class="detail-hero__metadata"><% if kind == :audiobook && people_with_role(item, "Writer").present? %><div><dt>Author</dt><dd><%= people_with_role(item, "Writer") %></dd></div><% end %><% if kind == :audiobook && people_with_role(item, "Narrator").present? %><div><dt>Narrator</dt><dd><%= people_with_role(item, "Narrator") %></dd></div><% end %><% if item["SeriesName"].present? %><div><dt>Series</dt><dd><%= item["SeriesName"] %></dd></div><% end %><% if item["RunTimeTicks"].present? %><div><dt>Length</dt><dd><%= track_duration(item["RunTimeTicks"]) %></dd></div><% end %><% if item["ProductionYear"].present? %><div><dt>Year</dt><dd><%= item["ProductionYear"] %></dd></div><% end %><% if item["Genres"].present? %><div><dt>Genres</dt><dd><%= item["Genres"].join(", ") %></dd></div><% end %></dl>
        </div>
      </section>
      <% if details.fetch(:chapters, []).any? %><section class="detail-section detail-chapters"><h2>Chapters</h2><ol><% details.fetch(:chapters, []).each_with_index do |chapter, index| %><li><span><%= index + 1 %></span><div><strong><%= chapter["Name"].presence || "Chapter #{index + 1}" %></strong><small><%= track_duration(chapter["StartPositionTicks"]) %></small></div><button type="button" aria-label="Play <%= chapter["Name"].presence || "chapter #{index + 1}" %>" data-action="player#replaceQueue" data-player-source-param="<%= audio_server_connection_path(@server_connection, item["Id"]) %>" data-player-item-id-param="<%= item["Id"] %>" data-player-reporting-url-param="<%= playback_reports_server_connection_path(@server_connection) %>" data-player-title-param="<%= item["Name"] %>" data-player-artist-param="<%= item["AlbumArtist"] || item["Artists"]&.join(", ") || "Audiobook" %>" data-player-artwork-param="<%= artwork_path %>" data-player-start-position-param="<%= chapter["StartPositionTicks"].to_i / 10_000_000.0 %>"><%= lucide_icon "play", aria: { hidden: true } %></button></li><% end %></ol></section><% end %>
    <% else %>
      <section class="detail-hero">
        <div class="detail-hero__art" data-media-header-target="artwork">
          <% artwork_path = media_artwork_path(@server_connection, album) %><%= image_tag artwork_path, alt: "" %>
          <% if album["Type"] == "MusicAlbum" || item["Type"].in?([ "MusicAlbum", "Audio", "Playlist" ]) %><button type="button" class="detail-hero__album-play" aria-label="Play <%= album["Name"] %>" data-action="player#replaceQueue" data-player-queue-url-param="<%= playback_queue_server_connection_path(@server_connection, album["Id"]) %>"><%= lucide_icon "play", aria: { hidden: true } %></button><div class="detail-hero__options" data-controller="detail-menu"><button type="button" class="listen-card__options-toggle" aria-label="More options for <%= album["Name"] %>" aria-expanded="false" data-detail-menu-target="toggle" data-action="detail-menu#toggle"><%= lucide_icon "ellipsis", aria: { hidden: true } %></button><div class="detail-hero__options-menu" data-detail-menu-target="menu" hidden><button type="button" class="detail-hero__album-download" aria-label="Download <%= album["Name"] %> for offline playback" data-action="offline-media#download" data-offline-media-queue-url="<%= playback_queue_server_connection_path(@server_connection, album["Id"]) %>" data-offline-media-title="<%= album["Name"] %>" data-offline-media-artist="<%= album["AlbumArtist"] || item["AlbumArtist"] %>" data-offline-media-artwork="<%= artwork_path %>"><%= lucide_icon "download", aria: { hidden: true } %> Download</button></div></div><% end %>
        </div>
      <% title_size = album["Name"].length > 48 ? "detail-hero__title--long" : album["Name"].length > 24 ? "detail-hero__title--compact" : ""; artist_name = album["AlbumArtist"] || item["AlbumArtist"]; artist_id = album.dig("AlbumArtists", 0, "Id") || item.dig("AlbumArtists", 0, "Id"); overview = album["Overview"] || item["Overview"] %><div><p class="detail-hero__kind"><%= item["Type"] == "MusicArtist" ? "Artist" : kind == :playlist ? "Playlist" : "Album" %></p><div class="detail-hero__title <%= title_size %>"><h1><%= album["Name"] %></h1></div><% if item["Type"] == "MusicArtist" %><button type="button" class="secondary-button" data-action="card-options#hideArtist" data-card-options-hide-url="<%= hidden_artists_path %>" data-card-options-hide-artist-id="<%= item["Id"] %>" data-card-options-hide-name="<%= item["Name"] %>" data-card-options-hide-server-connection-id="<%= @server_connection.id %>"><%= lucide_icon "eye-off", aria: { hidden: true } %> Hide artist</button><% end %><% if artist_name.present? %><p class="detail-hero__artist"><% if artist_id.present? %><%= link_to artist_name, library_item_server_connection_path(@server_connection, artist_id) %><% else %><%= artist_name %><% end %></p><% end %><% unless item["Type"] == "MusicArtist" %><p class="detail-hero__release"><%= kind == :playlist ? pluralize(details[:tracks].size, "track") : release_year(album) || "Album" %></p><% end %><% if overview.present? %><p><%= overview %></p><% end %></div>
      </section>
      <% if details[:tracks].any? %><section class="detail-section"><h2>Tracks</h2><ol class="track-list <%= "track-list--playlist" if kind == :playlist %>"><% details[:tracks].each_with_index do |track, index| %><li class="<%= "is-selected" if item["Type"] == "Audio" && track["Id"] == item["Id"] %>"><% unless kind == :playlist %><span><%= track["IndexNumber"] || index + 1 %></span><% end %><strong><%= track["Name"] %></strong><time><%= track_duration(track["RunTimeTicks"]) %></time><button type="button" class="listen-card__play" aria-label="Play <%= track["Name"] %>" data-action="player#replaceQueue" data-player-source-param="<%= audio_server_connection_path(@server_connection, track["Id"]) %>" data-player-item-id-param="<%= track["Id"] %>" data-player-reporting-url-param="<%= playback_reports_server_connection_path(@server_connection) %>" data-player-title-param="<%= track["Name"] %>" data-player-artist-param="<%= album["AlbumArtist"] || track["AlbumArtist"] || "Unknown artist" %>" data-player-artwork-param="<%= media_artwork_path(@server_connection, track) %>" data-player-radio-url-param="<%= radio_tracks_server_connection_path(@server_connection, track["Id"]) %>" data-player-radio-eligible-param="true"><%= lucide_icon "play", aria: { hidden: true } %></button><button type="button" class="track-list__queue" aria-label="Add <%= track["Name"] %> to queue" data-action="player#appendQueue" data-player-source-param="<%= audio_server_connection_path(@server_connection, track["Id"]) %>" data-player-item-id-param="<%= track["Id"] %>" data-player-reporting-url-param="<%= playback_reports_server_connection_path(@server_connection) %>" data-player-title-param="<%= track["Name"] %>" data-player-artist-param="<%= album["AlbumArtist"] || track["AlbumArtist"] || "Unknown artist" %>" data-player-artwork-param="<%= media_artwork_path(@server_connection, track) %>" data-player-radio-url-param="<%= radio_tracks_server_connection_path(@server_connection, track["Id"]) %>" data-player-radio-eligible-param="true"><%= lucide_icon "plus", aria: { hidden: true } %></button><button type="button" class="track-list__download" aria-label="Download <%= track["Name"] %> for offline playback" data-action="offline-media#download" data-offline-media-source="<%= audio_server_connection_path(@server_connection, track["Id"]) %>" data-offline-media-title="<%= track["Name"] %>" data-offline-media-artist="<%= album["AlbumArtist"] || track["AlbumArtist"] || "Unknown artist" %>" data-offline-media-artwork="<%= media_artwork_path(@server_connection, track) %>" data-offline-media-duration="<%= track_duration(track["RunTimeTicks"]) %>" data-offline-media-item-id="<%= track["Id"] %>" data-offline-media-album-id="<%= album["Id"] %>" data-offline-media-album="<%= album["Name"] %>" data-offline-media-album-artist="<%= album["AlbumArtist"] %>" data-offline-media-reporting-url="<%= playback_reports_server_connection_path(@server_connection) %>"><%= lucide_icon "download", aria: { hidden: true } %></button><% if kind == :playlist %><button type="button" class="track-list__remove" aria-label="Remove <%= track["Name"] %> from playlist" data-action="card-options#removePlaylistTrack" data-card-options-remove-playlist-track-url-param="<%= playlist_item_server_connection_path(@server_connection, playlist_id: album["Id"], entry_id: track["PlaylistItemId"] || track["Id"]) %>"><%= lucide_icon "trash-2", aria: { hidden: true } %></button><% end %></li><% end %></ol></section><% end %>
      <% if item["Type"] == "MusicArtist" %><%= render "shared/media_grid", title: "Albums", items: details[:other_albums], server_connection: @server_connection if details[:other_albums].any? %><% else %><% { "More by this artist" => details[:other_albums], "Similar albums" => details[:similar_albums] }.each do |title, albums| %><%= render "shared/media_shelf", title: title, eyebrow: "From your library", items: albums, server_connection: @server_connection if albums.any? %><% end %><% end %>
    <% end %>
  <% else %>
    <section class="listen-loading listen-loading--error"><h1>We couldn’t load this item.</h1><p><%= @result.message %></p></section>
  <% end %>
</main>
