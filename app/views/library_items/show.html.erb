<main class="settings-shell"><%= link_to "← Back to home", root_path, class: "back-link" %><% if @result.success? %><% details = @result.details; item = details[:item]; album = details[:album] %><section class="detail-hero"><div class="detail-hero__art"><% if (artwork_path = library_artwork_path(@server_connection, album)) %><%= image_tag artwork_path, alt: "" %><% end %></div><div><p class="listen-kicker"><%= item["Type"] == "Audio" ? "Track" : "Album" %></p><h1><%= item["Name"] %></h1><p><%= album["AlbumArtist"] || item["AlbumArtist"] %></p><p><%= item["Overview"] %></p></div></section><% if details[:tracks].any? %><section class="detail-section"><h2>Tracks</h2><ol class="track-list"><% details[:tracks].each do |track| %><li><span><%= track["IndexNumber"] %></span><strong><%= track["Name"] %></strong><time><%= track_duration(track["RunTimeTicks"]) %></time><button type="button" class="listen-card__play" aria-label="Play <%= track["Name"] %>" data-action="player#replaceQueue" data-player-source-param="<%= audio_server_connection_path(@server_connection, track["Id"]) %>" data-player-item-id-param="<%= track["Id"] %>" data-player-reporting-url-param="<%= playback_reports_server_connection_path(@server_connection) %>" data-player-title-param="<%= track["Name"] %>" data-player-artist-param="<%= album["AlbumArtist"] || track["AlbumArtist"] || "Unknown artist" %>" data-player-artwork-param="<%= library_artwork_path(@server_connection, track) || "/brand/sonzra-mark.svg" %>">▶</button><button type="button" class="track-list__queue" aria-label="Add <%= track["Name"] %> to queue" data-action="player#appendQueue" data-player-source-param="<%= audio_server_connection_path(@server_connection, track["Id"]) %>" data-player-item-id-param="<%= track["Id"] %>" data-player-reporting-url-param="<%= playback_reports_server_connection_path(@server_connection) %>" data-player-title-param="<%= track["Name"] %>" data-player-artist-param="<%= album["AlbumArtist"] || track["AlbumArtist"] || "Unknown artist" %>" data-player-artwork-param="<%= library_artwork_path(@server_connection, track) || "/brand/sonzra-mark.svg" %>">+</button></li><% end %></ol></section><% end %><% { "More by this artist" => details[:other_albums], "Similar albums" => details[:similar_albums] }.each do |title, albums| %><%= render "shared/media_shelf", title: title, eyebrow: "From your library", items: albums, server_connection: @server_connection %><% end %><% else %><section class="listen-loading listen-loading--error"><h1>We couldn’t load this item.</h1><p><%= @result.message %></p></section><% end %></main>
