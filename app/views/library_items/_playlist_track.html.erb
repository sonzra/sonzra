<li id="playlist_entry_<%= track["PlaylistItemId"] || track["Id"] %>">
  <strong data-artist="<%= track["AlbumArtist"] || track["Artists"]&.join(", ") || "Unknown artist" %>"><%= track["Name"] %></strong>
  <time><%= track_duration(track["RunTimeTicks"]) %></time>
  <button type="button" class="listen-card__play" aria-label="Play <%= track["Name"] %>" data-action="player#replaceQueue" data-player-source-param="<%= audio_server_connection_path(server_connection, track["Id"]) %>" data-player-item-id-param="<%= track["Id"] %>" data-player-reporting-url-param="<%= playback_reports_server_connection_path(server_connection) %>" data-player-title-param="<%= track["Name"] %>" data-player-artist-param="<%= album["AlbumArtist"] || track["AlbumArtist"] || "Unknown artist" %>" data-player-artwork-param="<%= media_artwork_path(server_connection, track) %>" data-player-radio-url-param="<%= radio_tracks_server_connection_path(server_connection, track["Id"]) %>" data-player-radio-eligible-param="true"><%= lucide_icon "play", aria: { hidden: true } %></button>
  <button type="button" class="track-list__queue" aria-label="Add <%= track["Name"] %> to queue" data-action="player#appendQueue" data-player-source-param="<%= audio_server_connection_path(server_connection, track["Id"]) %>" data-player-item-id-param="<%= track["Id"] %>" data-player-reporting-url-param="<%= playback_reports_server_connection_path(server_connection) %>" data-player-title-param="<%= track["Name"] %>" data-player-artist-param="<%= album["AlbumArtist"] || track["AlbumArtist"] || "Unknown artist" %>" data-player-artwork-param="<%= media_artwork_path(server_connection, track) %>" data-player-radio-url-param="<%= radio_tracks_server_connection_path(server_connection, track["Id"]) %>" data-player-radio-eligible-param="true"><%= lucide_icon "plus", aria: { hidden: true } %></button>
  <div class="detail-track__menu" data-controller="detail-menu" data-action="click->detail-menu#closeOnAction">
    <button type="button" class="detail-track__more" aria-label="More actions for <%= track["Name"] %>" aria-expanded="false" data-detail-menu-target="toggle" data-action="detail-menu#toggle"><%= lucide_icon "ellipsis", aria: { hidden: true } %></button>
    <div class="detail-track__menu-panel" data-detail-menu-target="menu" hidden>
      <button type="button" data-action="card-options#openPlaylistPickerFromButton" data-card-options-playlists-url-param="<%= playlists_server_connection_path(server_connection) %>" data-card-options-item-id-param="<%= track["Id"] %>" data-card-options-item-type-param="Audio"><%= lucide_icon "list-plus", aria: { hidden: true } %><span>Add to playlist</span></button>
      <button type="button" data-action="offline-media#download" data-offline-media-source="<%= audio_server_connection_path(server_connection, track["Id"]) %>" data-offline-media-title="<%= track["Name"] %>" data-offline-media-artist="<%= album["AlbumArtist"] || track["AlbumArtist"] || "Unknown artist" %>" data-offline-media-artwork="<%= media_artwork_path(server_connection, track) %>" data-offline-media-duration="<%= track_duration(track["RunTimeTicks"]) %>" data-offline-media-item-id="<%= track["Id"] %>" data-offline-media-album-id="<%= album["Id"] %>" data-offline-media-album="<%= album["Name"] %>" data-offline-media-album-artist="<%= album["AlbumArtist"] %>" data-offline-media-reporting-url="<%= playback_reports_server_connection_path(server_connection) %>"><%= lucide_icon "download", aria: { hidden: true } %><span>Download</span></button>
      <button type="button" class="is-danger" data-action="card-options#removePlaylistTrack" data-card-options-remove-playlist-track-url-param="<%= playlist_item_server_connection_path(server_connection, playlist_id: album["Id"], entry_id: track["PlaylistItemId"] || track["Id"]) %>"><%= lucide_icon "trash-2", aria: { hidden: true } %><span>Remove from playlist</span></button>
    </div>
  </div>
</li>
