<main class="settings-shell redesign-utility-page">
  <header class="settings-header settings-header--page">
    <div class="page-title">
      <%= link_to @server_connection, class: "back-link back-link--compact", aria: { label: "Back to #{@server_connection.name}" }, title: "Back to #{@server_connection.name}" do %>
        <%= lucide_icon "arrow-left", aria: { hidden: true } %>
      <% end %>
      <div>
        <p class="eyebrow">Server</p>
        <h1>Edit server</h1>
      </div>
    </div>
  </header>

  <section class="form-page form-page--compact">
    <%= render "form", server_connection: @server_connection %>
  </section>
</main>
