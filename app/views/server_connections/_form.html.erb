<%= form_with model: server_connection, url: server_connection.persisted? ? server_connection : start_quick_connect_server_connections_path, class: "connection-form" do |form| %>
  <%= form.hidden_field :media_server_id if server_connection.media_server.persisted? %>
  <%= form.hidden_field :setup_server, value: "true" if server_connection.media_server.new_record? %>
  <% if server_connection.errors.any? %>
    <div class="form-errors" role="alert">
      <h2><%= pluralize(server_connection.errors.count, "error") %> prevented this server from being saved:</h2>
      <ul>
        <% server_connection.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% if server_connection.media_server.new_record? %>
    <div class="field">
      <%= form.label :name, "Server name" %>
      <%= form.text_field :name, value: server_connection.media_server.name, autofocus: true, placeholder: "Home media server", required: true %>
    </div>

    <div class="field">
      <%= form.label :provider, "Server type" %>
      <%= form.select :provider, MediaServer::PROVIDERS.keys.map { |provider| [provider.capitalize, provider] }, { include_blank: "Choose a server type" }, required: true %>
    </div>

    <div class="field">
      <%= form.label :base_url, "Server address" %>
      <%= form.url_field :base_url, value: server_connection.media_server.base_url, placeholder: "https://media.example.com", required: true %>
      <p class="form-hint">Include the protocol. You can also include a path when the server is hosted below one.</p>
    </div>
  <% elsif current_user.admin? %>
    <div class="field">
      <%= form.label :name, "Server name" %>
      <%= form.text_field :name, value: server_connection.media_server.name, required: true %>
    </div>
    <div class="field">
      <%= form.label :base_url, "Server address" %>
      <%= form.url_field :base_url, value: server_connection.media_server.base_url, required: true %>
    </div>
  <% else %>
    <p class="form-hint">Connect your <%= server_connection.media_server.provider.capitalize %> account to <strong><%= server_connection.media_server.name %></strong>.</p>
  <% end %>

  <div class="form-actions">
    <%= link_to "Cancel", server_connections_path, class: "secondary-button" %>
    <% submit_label = if server_connection.persisted? then "Save server" elsif server_connection.media_server.provider.present? then "Connect with #{server_connection.media_server.provider.capitalize}" else "Continue" end %><%= form.submit submit_label, class: "primary-button" if !server_connection.persisted? || current_user.admin? %>
  </div>
<% end %>
