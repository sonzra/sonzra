<%= form_with model: server_connection, url: server_connection.persisted? ? server_connection : start_quick_connect_server_connections_path, class: "connection-form" do |form| %>
  <% if server_connection.errors.any? %>
    <div class="form-errors" role="alert">
      <h2><%= pluralize(server_connection.errors.count, "error") %> prevented this server from being saved:</h2>
      <ul>
        <% server_connection.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% if server_connection.media_server.new_record? %>
    <div class="field">
      <%= form.label :name, "Server name" %>
      <%= form.text_field :name, value: server_connection.media_server.name, autofocus: true, placeholder: "Home Jellyfin", required: true %>
    </div>

    <div class="field">
      <%= form.label :provider, "Server type" %>
      <%= form.select :provider, MediaServer::PROVIDERS.keys.map { |provider| [provider.capitalize, provider] }, selected: server_connection.media_server.provider || :jellyfin %>
    </div>

    <div class="field">
      <%= form.label :base_url, "Server address" %>
      <%= form.url_field :base_url, value: server_connection.media_server.base_url, placeholder: "https://jellyfin.example.com", required: true %>
      <p class="form-hint">Include the protocol. A path is supported, such as <code>https://example.com/jellyfin</code>.</p>
    </div>
  <% elsif current_user.admin? %>
    <div class="field">
      <%= form.label :name, "Server name" %>
      <%= form.text_field :name, value: server_connection.media_server.name, required: true %>
    </div>
    <div class="field">
      <%= form.label :base_url, "Server address" %>
      <%= form.url_field :base_url, value: server_connection.media_server.base_url, required: true %>
    </div>
  <% else %>
    <p class="form-hint">Connect your Jellyfin account to <strong><%= server_connection.media_server.name %></strong>.</p>
  <% end %>

  <div class="form-actions">
    <%= link_to "Cancel", server_connections_path, class: "secondary-button" %>
    <%= form.submit server_connection.persisted? ? "Save server" : "Connect with Jellyfin", class: "primary-button" if !server_connection.persisted? || current_user.admin? %>
  </div>
<% end %>
