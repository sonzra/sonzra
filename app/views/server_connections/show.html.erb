<main class="settings-shell">
  <header class="settings-header">
    <%= link_to server_connections_path, class: "back-link back-link--compact", aria: { label: "Back to servers" }, title: "Back to servers" do %><%= lucide_icon "arrow-left", aria: { hidden: true } %><% end %>
    <div class="settings-header__actions">
      <%= link_to "Edit", edit_server_connection_path(@server_connection), class: "secondary-button" %>
      <%= button_to "Remove", @server_connection, method: :delete, class: "text-button text-button--danger", form: { data: { turbo_confirm: "Remove this server connection?" } } %>
    </div>
  </header>

  <%= render "shared/flash" %>

  <section class="connection-detail connection-detail--compact">
    <h1><%= @server_connection.name %></h1>
    <p><%= @server_connection.base_url %></p>

    <div class="connection-detail__credentials"><span>Connected as</span><strong><%= @server_connection.username %></strong></div>

    <%= button_to "Test connection", test_connection_server_connection_path(@server_connection), class: "primary-button" %>
  </section>
</main>
