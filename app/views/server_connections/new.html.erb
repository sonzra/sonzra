<main class="settings-shell redesign-utility-page">
  <% page_title = if @media_server&.persisted? then "Connect #{@media_server.provider.capitalize} account" elsif @media_server then "Add server" else "Choose a server" end %>
  <header class="settings-header settings-header--page">
    <div class="page-title">
      <%= link_to server_connections_path, class: "back-link back-link--compact", aria: { label: "Back to servers" }, title: "Back to servers" do %>
        <%= lucide_icon "arrow-left", aria: { hidden: true } %>
      <% end %>
      <div>
        <p class="eyebrow">Settings</p>
        <h1><%= page_title %></h1>
      </div>
    </div>
  </header>

  <section class="form-page form-page--compact">
    <% if @media_server %>
      <%= render "form", server_connection: @server_connection %>
    <% elsif @available_media_servers.any? %>
      <p class="form-hint">Choose a configured server to connect your account.</p>
      <section class="connection-list">
        <% @available_media_servers.each do |media_server| %>
          <article class="connection-card">
            <div class="connection-card__info">
              <div class="connection-card__badges">
                <span class="connection-badge connection-badge--provider"><%= media_server.provider.capitalize %></span>
              </div>
              <h2><%= media_server.name %></h2>
              <p class="connection-card__meta"><%= media_server.base_url %></p>
            </div>
            <div class="connection-card__actions">
              <%= link_to "Connect", new_server_connection_path(media_server_id: media_server.id), class: "primary-button" %>
            </div>
          </article>
        <% end %>
      </section>
    <% else %>
      <section class="empty-state">
        <%= image_tag "/brand/sonzra-mark.svg", alt: "", class: "empty-state__mark" %>
        <h2>No server is available</h2>
        <p>An administrator needs to add a server before you can connect an account.</p>
      </section>
    <% end %>
  </section>
</main>
