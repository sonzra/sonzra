<nav class="redesign-library-tabs" aria-label="Library sections">
  <% { albums: [ "Albums", library_albums_path ], artists: [ "Artists", library_artists_path ], playlists: [ "Playlists", library_playlists_path ], podcasts: [ "Podcasts", library_podcasts_path ], audiobooks: [ "Audiobooks", library_audiobooks_path ], genres: [ "Genres", library_genres_path ] }.each do |collection, (label, path)| %>
    <% count = @library_tab_counts&.fetch(collection, nil) %>
    <%= link_to path, aria: (current_page?(path) ? { current: "page" } : {}) do %><span><%= label %></span><b><%= count.nil? ? "—" : number_with_delimiter(count) %></b><% end %>
  <% end %>
</nav>
