<header class="redesign-media-topbar" data-media-header-target="bar">
  <%= link_to @back_path, class: "redesign-media-topbar__back", aria: { label: "Back to #{@back_label}" }, data: { controller: "history-back", action: "click->history-back#go" } do %><%= lucide_icon "arrow-left", aria: { hidden: true } %><% end %>
  <p><%= @media_detail_title %></p>
  <span class="redesign-media-topbar__art" aria-hidden="true"><img data-media-header-target="thumbnail" alt=""></span>
</header>
