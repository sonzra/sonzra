<% genre_name = item["Type"].in?([ "MusicGenre", "Genre" ]) ? item["Name"] : (item["Genres"]&.first || item.dig("GenreItems", 0, "Name")) %>
<div class="listen-card__options" <% if item["Type"].in?([ "Audio", "MusicAlbum" ]) %>data-card-options-playlists-url="<%= playlists_server_connection_path(server_connection) %>" data-card-options-item-id="<%= item["Id"] %>" data-card-options-item-type="<%= item["Type"] %>"<% end %> <% if item["Type"] == "MusicArtist" %>data-card-options-hide-url="<%= hidden_artists_path %>" data-card-options-hide-artist-id="<%= item["Id"] %>" data-card-options-hide-name="<%= item["Name"] %>" data-card-options-hide-server-connection-id="<%= server_connection.id %>"<% elsif item["Type"] == "Audio" %>data-card-options-favorite-url="<%= favorite_server_connection_path(server_connection, item_id: item["Id"]) %>" data-card-options-favorite="<%= item.dig("UserData", "IsFavorite") ? "true" : "false" %>"<% elsif item["Type"] == "Playlist" && item["CollaborationStatus"] != :shared_with_me && item["IsOwner"] != false %>data-card-options-delete-playlist-url="<%= playlist_server_connection_path(server_connection, item["Id"]) %>"<% end %><% if genre_name.present? %> data-card-options-hide-genre-url="<%= hidden_genres_path %>" data-card-options-hide-genre-name="<%= genre_name %>" data-card-options-hide-genre-server-connection-id="<%= server_connection.id %>"<% end %>>
  <button class="listen-card__options-toggle" type="button" aria-label="More options for <%= item["Name"] %>" aria-expanded="false" data-action="card-options#toggle"><%= lucide_icon "ellipsis", aria: { hidden: true } %></button>
</div>
