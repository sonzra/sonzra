<aside id="player" class="listen-player" aria-label="Now playing" data-player-target="shell" data-turbo-permanent hidden>
  <audio data-player-target="audio" preload="auto" playsinline></audio>
  <button type="button" class="listen-player__track" aria-label="Open now playing" data-action="player#openQueue">
    <img class="listen-player__art" data-player-target="artwork" src="/brand/sonzra-mark.svg" alt="">
    <span class="listen-player__metadata"><strong data-player-target="title">Choose something to play</strong><span data-player-target="artist">Your player will stay here</span></span>
  </button>
  <div class="listen-player__controls"><span class="listen-player__time" aria-label="Playback time"><span data-player-target="elapsed">0:00</span><span aria-hidden="true"> / </span><span data-player-target="duration">0:00</span></span><button type="button" aria-label="Add to favourites" class="listen-player__favorite" data-player-target="favorite" data-action="player#toggleFavorite"><%= lucide_icon "heart", aria: { hidden: true } %></button><button type="button" class="listen-player__skip" aria-label="Previous track" data-action="player#previous"><%= lucide_icon "skip-back", aria: { hidden: true } %></button><button type="button" aria-label="Play" class="listen-player__play" data-player-target="toggle" data-action="player#toggle"><%= lucide_icon "play", aria: { hidden: true } %></button><button type="button" class="listen-player__skip" aria-label="Next track" data-action="player#next"><%= lucide_icon "skip-forward", aria: { hidden: true } %></button></div>
  <div class="listen-player__progress" aria-hidden="true"><span data-player-target="miniProgress"></span></div>
</aside>
