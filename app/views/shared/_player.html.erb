<aside id="player" class="listen-player" aria-label="Now playing" data-player-target="shell" data-turbo-permanent hidden>
  <audio data-player-target="audio" preload="auto" playsinline></audio>
  <% if redesign_enabled? %>
    <div class="listen-player__identity">
      <button type="button" class="listen-player__track" aria-label="Open now playing" data-action="player#openQueue">
        <img class="listen-player__art" data-player-target="artwork" src="/brand/sonzra-mark.svg" alt="">
        <span class="listen-player__metadata"><strong data-player-target="title">Choose something to play</strong><span data-player-target="artist">Your player will stay here</span></span>
      </button>
      <span class="listen-player__playing-mark" aria-hidden="true"><i></i><i></i><i></i></span>
      <button type="button" aria-label="Add to favourites" class="listen-player__favorite" data-player-target="favorite" data-action="player#toggleFavorite"><%= lucide_icon "heart", aria: { hidden: true } %></button>
    </div>
    <div class="listen-player__center">
      <div class="listen-player__controls"><button type="button" class="listen-player__utility" aria-label="Radio off" title="Radio off" data-player-target="radio" data-action="player#toggleRadio"><%= lucide_icon "radio", aria: { hidden: true } %></button><button type="button" class="listen-player__skip" aria-label="Previous track" data-action="player#previous"><%= lucide_icon "skip-back", aria: { hidden: true } %></button><button type="button" aria-label="Play" class="listen-player__play" data-player-target="toggle" data-action="player#toggle"><%= lucide_icon "play", aria: { hidden: true } %></button><button type="button" class="listen-player__skip" aria-label="Next track" data-action="player#next"><%= lucide_icon "skip-forward", aria: { hidden: true } %></button><button type="button" class="listen-player__utility" aria-label="Repeat off" title="Repeat off" data-player-target="repeat" data-action="player#toggleRepeat"><%= lucide_icon "repeat", aria: { hidden: true } %></button></div>
      <div class="listen-player__playback"><time data-player-target="elapsed">0:00</time><input class="listen-player__timeline" data-player-target="timeline" data-action="input->player#seek" type="range" min="0" max="0" value="0" step="0.1" aria-label="Playback position"><time data-player-target="duration">0:00</time></div>
    </div>
    <div class="listen-player__right"><button type="button" class="listen-player__utility" aria-label="Open lyrics" title="Open lyrics" data-action="player#openLyrics"><%= lucide_icon "scroll-text", aria: { hidden: true } %></button><button type="button" class="listen-player__queue-button" aria-label="Open queue" title="Open queue" data-action="player#toggleQueue"><%= lucide_icon "list-music", aria: { hidden: true } %></button><label class="listen-player__volume" aria-label="Volume"><%= lucide_icon "volume-2", aria: { hidden: true } %><input data-player-target="volume" data-action="input->player#setVolume" type="range" min="0" max="1" step="0.01" value="0.8" aria-label="Volume"></label></div>
  <% else %>
  <button type="button" class="listen-player__track" aria-label="Open now playing" data-action="player#openQueue">
    <img class="listen-player__art" data-player-target="artwork" src="/brand/sonzra-mark.svg" alt="">
    <span class="listen-player__metadata"><strong data-player-target="title">Choose something to play</strong><span data-player-target="artist">Your player will stay here</span></span>
  </button>
  <div class="listen-player__controls"><span class="listen-player__time" aria-label="Playback time"><span data-player-target="elapsed">0:00</span><span aria-hidden="true"> / </span><span data-player-target="duration">0:00</span></span><button type="button" aria-label="Add to favourites" class="listen-player__favorite" data-player-target="favorite" data-action="player#toggleFavorite"><%= lucide_icon "heart", aria: { hidden: true } %></button><button type="button" class="listen-player__skip" aria-label="Previous track" data-action="player#previous"><%= lucide_icon "skip-back", aria: { hidden: true } %></button><button type="button" aria-label="Play" class="listen-player__play" data-player-target="toggle" data-action="player#toggle"><%= lucide_icon "play", aria: { hidden: true } %></button><button type="button" class="listen-player__skip" aria-label="Next track" data-action="player#next"><%= lucide_icon "skip-forward", aria: { hidden: true } %></button></div>
  <% end %>
  <div class="listen-player__progress" aria-hidden="true"><span data-player-target="miniProgress"></span></div>
</aside>
