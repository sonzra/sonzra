<% offline_navigation = local_assigns.fetch(:offline, false) %>
<% navigation_data = offline_navigation ? { action: "click->offline-connection#preventNavigation click->navigation#closeOnNavigation", offline_connection_target: "navigationLink" } : {} %>
<% disabled_aria = offline_navigation ? { disabled: true } : {} %>
<% primary_links = { "Home" => [ root_path, "house" ], "Library" => [ library_albums_path, "library" ], "Discover" => [ recommendation_collections_path, "sparkles" ] } %>
<% library_links = { "Artists" => [ library_artists_path, "mic-vocal" ], "Albums" => [ library_albums_path, "disc-3" ], "Playlists" => [ library_playlists_path, "list-music" ], "Audiobooks" => [ library_audiobooks_path, "book-open" ], "Podcasts" => [ library_podcasts_path, "podcast" ], "Sonic Map" => [ sonic_graph_path, "network" ], "Downloads" => [ offline_downloads_path, "download" ] } %>
<header class="redesign-topbar" data-controller="navigation library-search" data-library-search-global-value="true">
  <%= link_to root_path, class: "redesign-brand", data: navigation_data, aria: { label: "Sonzra home" }.merge(disabled_aria) do %><%= image_tag "/brand/sonzra-mark.svg", alt: "", class: "redesign-brand__mark" %><span>sonzra</span><% end %>
  <nav class="redesign-topbar__primary" aria-label="Primary navigation">
    <% primary_links.each do |label, (path, icon)| %><%= link_to path, class: "redesign-topbar__link", data: navigation_data, aria: disabled_aria.merge(current_page?(path) ? { current: "page" } : {}) do %><%= lucide_icon icon, aria: { hidden: true } %><span><%= label %></span><% end %><% end %>
  </nav>
  <div class="redesign-topbar__actions">
    <button type="button" class="redesign-icon-button redesign-search-trigger" aria-label="Search your library" data-action="library-search#open"><%= lucide_icon "search", aria: { hidden: true } %><kbd>⌘ K</kbd></button>
    <% if current_server_connection %><span class="redesign-server-pill" title="Connected to <%= current_server_connection.name %>"><i></i><span><%= current_server_connection.name %></span></span><% end %>
    <div class="redesign-profile" data-controller="profile-menu">
      <button type="button" class="redesign-profile__toggle" aria-label="Open profile menu" aria-expanded="false" data-profile-menu-target="toggle" data-action="profile-menu#toggle"><%= lucide_icon "circle-user-round", aria: { hidden: true } %><span><%= current_user.email_address.split("@").first %></span></button>
      <div class="redesign-profile__menu" data-profile-menu-target="menu" data-action="click->profile-menu#closeOnAction" hidden>
        <p>Library</p>
        <% library_links.each do |label, (path, icon)| %><%= link_to path, data: navigation_data, aria: disabled_aria do %><%= lucide_icon icon, aria: { hidden: true } %><span><%= label %></span><% end %><% end %>
        <% if current_user.server_connections.many? %><p>Servers</p><% current_user.server_connections.order(:created_at).each do |connection| %><%= button_to active_server_connection_path, method: :patch, params: { server_connection_id: connection.id }, class: ("is-active" if current_server_connection == connection), form: { data: { controller: "server-switch", action: "submit->server-switch#switch", server_switch_connection_id_value: connection.id, server_switch_current_connection_id_value: current_server_connection.id } } do %><%= lucide_icon "server", aria: { hidden: true } %><span><%= connection.name %></span><% end %><% end %><% end %>
        <p>Account</p>
        <%= link_to server_connections_path, data: navigation_data, aria: disabled_aria do %><%= lucide_icon "server", aria: { hidden: true } %><span>Server connections</span><% end %>
        <%= link_to hidden_artists_path, data: navigation_data, aria: disabled_aria do %><%= lucide_icon "eye-off", aria: { hidden: true } %><span>Hidden artists</span><% end %>
        <% if current_user.admin? %><%= link_to admin_users_path, data: navigation_data, aria: disabled_aria do %><%= lucide_icon "users", aria: { hidden: true } %><span>Users</span><% end %><%= link_to admin_registration_settings_path, data: navigation_data, aria: disabled_aria do %><%= lucide_icon "shield-check", aria: { hidden: true } %><span>Administration</span><% end %><% end %>
        <%= button_to interface_preference_path, method: :patch, params: { ui_variant: "legacy" }, form: { data: { turbo: false } } do %><%= lucide_icon "monitor-up", aria: { hidden: true } %><span>Use classic interface</span><% end %>
        <% if offline_navigation %><button type="button" disabled><%= lucide_icon "log-out", aria: { hidden: true } %><span>Sign out</span></button><% else %><%= button_to session_path, method: :delete, form: { data: { turbo: false } } do %><%= lucide_icon "log-out", aria: { hidden: true } %><span>Sign out</span><% end %><% end %>
      </div>
    </div>
  </div>
  <button class="redesign-topbar__menu-toggle" type="button" aria-label="Open navigation menu" aria-expanded="false" data-navigation-target="toggle" data-action="navigation#toggle"><%= lucide_icon "menu", aria: { hidden: true } %></button>
  <div class="redesign-mobile-menu" data-navigation-target="menu" data-action="click->navigation#closeOnNavigation">
    <button type="button" class="redesign-mobile-menu__search" data-action="library-search#open"><%= lucide_icon "search", aria: { hidden: true } %><span>Search your library</span></button>
    <% library_links.each do |label, (path, icon)| %><%= link_to path, data: navigation_data, aria: disabled_aria do %><%= lucide_icon icon, aria: { hidden: true } %><span><%= label %></span><% end %><% end %>
    <%= link_to server_connections_path, data: navigation_data, aria: disabled_aria do %><%= lucide_icon "server", aria: { hidden: true } %><span>Server connections</span><% end %>
    <%= link_to hidden_artists_path, data: navigation_data, aria: disabled_aria do %><%= lucide_icon "eye-off", aria: { hidden: true } %><span>Hidden artists</span><% end %>
    <% if current_user.admin? %><%= link_to admin_users_path, data: navigation_data, aria: disabled_aria do %><%= lucide_icon "users", aria: { hidden: true } %><span>Users</span><% end %><%= link_to admin_registration_settings_path, data: navigation_data, aria: disabled_aria do %><%= lucide_icon "shield-check", aria: { hidden: true } %><span>Administration</span><% end %><% end %>
    <%= button_to interface_preference_path, method: :patch, params: { ui_variant: "legacy" }, form: { data: { turbo: false } } do %><%= lucide_icon "monitor-up", aria: { hidden: true } %><span>Use classic interface</span><% end %>
  </div>
  <dialog class="redesign-search-dialog" aria-label="Search your library" data-library-search-target="dialog" data-action="click->library-search#closeOnBackdrop">
    <div class="redesign-search-dialog__panel"><div class="redesign-search-dialog__heading"><div><p>Jump around</p><h2>Search your library</h2></div><button type="button" aria-label="Close search" data-action="library-search#close"><%= lucide_icon "x", aria: { hidden: true } %></button></div><%= form_with url: library_albums_path, method: :get do |form| %><%= form.search_field :q, placeholder: "Albums, artists, songs…", autocomplete: "off", data: { library_search_target: "input" } %><%= form.submit "Search" %><% end %><div class="redesign-search-dialog__shortcuts"><%= link_to library_albums_path do %><%= lucide_icon "disc-3", aria: { hidden: true } %><span><strong>Albums</strong><small>Browse your collection</small></span><%= lucide_icon "arrow-up-right", aria: { hidden: true } %><% end %><%= link_to library_artists_path do %><%= lucide_icon "mic-vocal", aria: { hidden: true } %><span><strong>Artists</strong><small>Explore your library</small></span><%= lucide_icon "arrow-up-right", aria: { hidden: true } %><% end %><%= link_to recommendation_collections_path do %><%= lucide_icon "sparkles", aria: { hidden: true } %><span><strong>Your mixes</strong><small>Find something new</small></span><%= lucide_icon "arrow-up-right", aria: { hidden: true } %><% end %></div></div>
  </dialog>
  <% if offline_navigation %><div class="offline-connection" role="status"><span data-offline-connection-target="status" data-state="checking">Checking connection…</span><button type="button" data-offline-connection-target="retry" data-action="offline-connection#check">Check again</button></div><% end %>
</header>
<nav class="redesign-bottom-nav" aria-label="Mobile navigation"><% primary_links.each do |label, (path, icon)| %><%= link_to path, data: navigation_data, aria: disabled_aria.merge(current_page?(path) ? { current: "page" } : {}) do %><%= lucide_icon icon, aria: { hidden: true } %><span><%= label %></span><% end %><% end %><button type="button" data-action="player#toggleQueue"><%= lucide_icon "list-music", aria: { hidden: true } %><span>Queue</span></button></nav>
