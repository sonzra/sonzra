<main class="settings-shell">
  <section class="form-page form-page--compact">
    <div class="page-title"><%= link_to admin_registration_settings_path, class: "back-link back-link--compact", aria: { label: "Back to administration" }, title: "Back to administration" do %><%= lucide_icon "arrow-left", aria: { hidden: true } %><% end %><h1>Users</h1></div>
    <p class="form-hint">Each person connects their own Jellyfin account, keeping their listening data private.</p>
    <p><%= link_to "Add user", new_admin_user_path, class: "primary-button" %></p>
    <section class="connection-list" aria-label="Sonzra users">
      <% @users.each do |user| %>
        <article class="connection-card">
          <div><h2><%= user.email_address %></h2><p><%= user.admin? ? "Administrator" : "User" %></p></div>
        </article>
      <% end %>
    </section>
  </section>
</main>
