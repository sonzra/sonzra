<% content_for :title, "Notifications - Sonzra" %>

<main class="redesign listen-main settings-shell">
  <div class="settings-shell__content">
    <div class="redesign-page-intro">
      <div class="page-title">
        <div>
          <p class="eyebrow">Activity</p>
          <h1>Notifications</h1>
        </div>
        <div class="page-actions">
          <%= link_to root_path, class: "ghost-button" do %>
            <%= lucide_icon "arrow-left", aria: { hidden: true } %>
            <span>Back</span>
          <% end %>
        </div>
      </div>
    </div>

    <div data-controller="notifications">
      <%= render "notifications/drawer", notifications: @notifications, standalone: true %>
    </div>
  </div>
</main>
