<% count = local_assigns.fetch(:count, 0).to_i %>
<span id="notifications_badge"
      class="redesign-notification-badge"
      <%= "hidden" if count.zero? %>
      aria-live="polite"
      role="status"
      aria-label="<%= pluralize(count, 'unread notification') %>">
  <%= count > 9 ? "9+" : count %>
</span>
