<% current_collection = defined?(collection) && collection ? collection : @collection %>
<% items.each do |item| %>
  <% artwork_path = library_artwork_path(server_connection, item) %>
  <% actionable = item["Type"].in?([ "Audio", "AudioBook", "MusicAlbum", "MusicArtist", "Playlist" ]) %>
  <article class="listen-card" data-controller="card-link" data-card-link-url-value="<%= library_item_server_connection_path(server_connection, item["Id"]) %>" data-action="touchstart->card-options#startPress touchend->card-options#cancelPress touchcancel->card-options#cancelPress touchmove->card-options#cancelPress contextmenu->card-options#preventContextMenu click->card-options#consumeClick click->card-link#visit">
    <%= link_to library_item_server_connection_path(server_connection, item["Id"]), class: "listen-card__art" do %><% if artwork_path %><%= image_tag artwork_path, alt: "", loading: "lazy" %><% else %><%= image_tag "/brand/sonzra-mark.svg", class: "listen-card__fallback", alt: "" %><% end %><% end %>
    <% if item["Type"].in?([ "Audio", "AudioBook" ]) %><button class="listen-card__play" type="button" aria-label="Play <%= item["Name"] %>" data-action="player#replaceQueue" data-player-source-param="<%= audio_server_connection_path(server_connection, item["Id"]) %>" data-player-item-id-param="<%= item["Id"] %>" data-player-reporting-url-param="<%= playback_reports_server_connection_path(server_connection) %>" data-player-title-param="<%= item["Name"] %>" data-player-artist-param="<%= item["AlbumArtist"] || item["Artists"]&.join(", ") || "Audiobook" %>" data-player-artwork-param="<%= artwork_path || "/brand/sonzra-mark.svg" %>" data-player-duration-param="<%= track_duration(item["RunTimeTicks"]) %>"><%= lucide_icon "play", aria: { hidden: true } %></button><% elsif item["Type"].in?([ "MusicAlbum", "MusicArtist", "Playlist" ]) %><button class="listen-card__play" type="button" aria-label="Play <%= item["Name"] %>" data-action="player#replaceQueue" data-player-queue-url-param="<%= playback_queue_server_connection_path(server_connection, item["Id"]) %>"><%= lucide_icon "play", aria: { hidden: true } %></button><% end %>
    <%= render "shared/card_options", item: item, artwork_path: artwork_path, server_connection: server_connection if actionable %>
    <h3><%= link_to item["Name"], library_item_server_connection_path(server_connection, item["Id"]) %></h3><p><%= current_collection == :podcasts ? "Podcast show" : current_collection == :playlists ? "Playlist" : item["AlbumArtist"] || item["Artists"]&.join(", ") || item["Type"] %></p>
  </article>
<% end %>
