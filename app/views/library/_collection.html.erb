<main class="settings-shell">
  <header class="settings-header"><%= link_to "← Home", root_path, class: "back-link" %></header>
  <% if @result.success? %>
    <section class="settings-intro">
      <span class="eyebrow">Your library</span><h1><%= @title %></h1>
      <%= form_with url: request.path, method: :get, class: "library-search" do |form| %>
        <%= form.hidden_field :genre, value: @genre if @genre %>
        <%= form.search_field :q, value: @query, placeholder: "Search #{@title.downcase}" %><%= form.submit "Search" %>
      <% end %>
    </section>
    <div class="library-grid">
      <% @result.items.each do |item| %>
        <% artwork_path = library_artwork_path(@server_connection, item) %>
        <% playable = item["Type"].in?([ "Audio", "AudioBook" ]) %>
        <article class="listen-card">
          <%= link_to library_item_server_connection_path(@server_connection, item["Id"]), class: "listen-card__art" do %>
            <% if artwork_path %><%= image_tag artwork_path, alt: "", loading: "lazy" %><% else %><%= image_tag "/brand/sonzra-mark.svg", class: "listen-card__fallback", alt: "" %><% end %>
          <% end %>
          <% if playable %>
            <button class="listen-card__play" type="button" aria-label="Play <%= item["Name"] %>" data-action="player#replaceQueue" data-player-source-param="<%= audio_server_connection_path(@server_connection, item["Id"]) %>" data-player-item-id-param="<%= item["Id"] %>" data-player-reporting-url-param="<%= playback_reports_server_connection_path(@server_connection) %>" data-player-title-param="<%= item["Name"] %>" data-player-artist-param="<%= item["AlbumArtist"] || item["Artists"]&.join(", ") || "Audiobook" %>" data-player-artwork-param="<%= artwork_path || "/brand/sonzra-mark.svg" %>" data-player-duration-param="<%= track_duration(item["RunTimeTicks"]) %>">▶</button><button class="listen-card__queue" type="button" aria-label="Add <%= item["Name"] %> to queue" data-action="player#appendQueue" data-player-source-param="<%= audio_server_connection_path(@server_connection, item["Id"]) %>" data-player-item-id-param="<%= item["Id"] %>" data-player-reporting-url-param="<%= playback_reports_server_connection_path(@server_connection) %>" data-player-title-param="<%= item["Name"] %>" data-player-artist-param="<%= item["AlbumArtist"] || item["Artists"]&.join(", ") || "Audiobook" %>" data-player-artwork-param="<%= artwork_path || "/brand/sonzra-mark.svg" %>" data-player-duration-param="<%= track_duration(item["RunTimeTicks"]) %>">+</button>
          <% elsif item["Type"] == "MusicAlbum" %>
            <button class="listen-card__play" type="button" aria-label="Play <%= item["Name"] %>" data-action="player#replaceQueue" data-player-queue-url-param="<%= playback_queue_server_connection_path(@server_connection, item["Id"]) %>">▶</button><button class="listen-card__queue" type="button" aria-label="Add <%= item["Name"] %> to queue" data-action="player#appendQueue" data-player-queue-url-param="<%= playback_queue_server_connection_path(@server_connection, item["Id"]) %>">+</button>
          <% elsif item["Type"] == "MusicArtist" %>
            <button class="listen-card__play" type="button" aria-label="Play random songs by <%= item["Name"] %>" data-action="player#replaceQueue" data-player-queue-url-param="<%= playback_queue_server_connection_path(@server_connection, item["Id"]) %>">▶</button><button class="listen-card__queue" type="button" aria-label="Add random songs by <%= item["Name"] %> to queue" data-action="player#appendQueue" data-player-queue-url-param="<%= playback_queue_server_connection_path(@server_connection, item["Id"]) %>">+</button>
          <% end %>
          <h3><%= link_to item["Name"], library_item_server_connection_path(@server_connection, item["Id"]) %></h3>
          <p><%= item["AlbumArtist"] || item["Artists"]&.join(", ") || item["Type"] %></p>
        </article>
      <% end %>
    </div>
    <nav class="library-pagination">
      <%= link_to "← Previous", url_for(page: @page - 1, q: @query, genre: @genre), class: "secondary-button" if @page > 1 %>
      <span>Page <%= @page %> of <%= [(@result.total / 48.0).ceil, 1].max %></span>
      <%= link_to "Next →", url_for(page: @page + 1, q: @query, genre: @genre), class: "secondary-button" if @page * 48 < @result.total %>
    </nav>
  <% else %>
    <section class="listen-loading listen-loading--error"><h1>We couldn’t load your <%= @title.downcase %>.</h1><p><%= @result.message %></p></section>
  <% end %>
</main>
