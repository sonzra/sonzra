<main class="redesign-library-page">
  <% if @result.success? %>
    <% shelf_collection = @collection.in?([ :recently_played, :most_played_songs, :recently_added_albums ]) %>
    <% infinite_collection = @collection.in?([ :albums, :artists ]) %>

    <header class="redesign-library-heading">
      <div>
        <p class="eyebrow">Your collection</p>
        <h1>Library</h1>
        <p>Everything on your server, beautifully organized.</p>
      </div>
    </header>

    <%= render "shared/redesign_library_tabs" unless shelf_collection %>

    <section class="redesign-library-content" aria-labelledby="library-collection-title">
      <div class="redesign-library-content__heading">
        <div>
          <p class="eyebrow">Browse</p>
          <h2 id="library-collection-title"><%= @title %></h2>
        </div>
        <%= render "shared/library_search", title: @title, path: request.path, query: @query, genre: @genre unless shelf_collection %>
      </div>

      <% if shelf_collection %>
        <%= render "music_shelf_collection" %>
      <% elsif infinite_collection %>
        <div class="redesign-library-layout library-page-layout <%= "library-page-layout--browsable" if @supports_letter_filtering %>"
             data-controller="library-pagination"
             data-library-pagination-has-more-value="<%= @result.has_more %>"
             data-library-pagination-page-value="<%= @page %>"
             data-library-pagination-letter-value="<%= @letter %>"
             data-library-pagination-url-value="<%= request.path %>">
          <div class="library-grid-wrapper">
            <div class="library-grid redesign-library-grid" id="library-grid" data-library-pagination-target="grid">
              <%= render "grid_items", items: @result.items, server_connection: @server_connection %>
            </div>
            <div data-library-pagination-target="sentinel" class="library-infinite-sentinel" aria-hidden="true"></div>
            <%= render "scroll_state", has_more: @result.has_more, page: @page, letter: @letter %>
          </div>
          <%= render "alphabet_sidebar" if @supports_letter_filtering %>
        </div>
      <% else %>
        <div class="library-grid redesign-library-grid">
          <%= render "grid_items", items: @result.items, server_connection: @server_connection %>
        </div>
        <nav class="library-pagination"><%= link_to "← Previous", url_for(page: @page - 1, q: @query, genre: @genre), class: "secondary-button" if @page > 1 %><span>Page <%= @page %> of <%= [(@result.total / Library::Pagination::PAGE_SIZE.to_f).ceil, 1].max %></span><%= link_to "Next →", url_for(page: @page + 1, q: @query, genre: @genre), class: "secondary-button" if @page * Library::Pagination::PAGE_SIZE < @result.total %></nav>
      <% end %>
    </section>
  <% else %>
    <section class="listen-loading listen-loading--error"><h1>We couldn’t load your <%= @title.downcase %>.</h1><p><%= @result.message %></p></section>
  <% end %>
</main>
