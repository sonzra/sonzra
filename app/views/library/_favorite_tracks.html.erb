<ol class="library-media-list redesign-search-track-list redesign-favorite-track-list" aria-label="Favorite tracks">
  <% items.each do |item| %>
    <% artwork_path = media_artwork_path(server_connection, item) %>
    <% artist = item["AlbumArtist"] || item["Artists"]&.join(", ") || "Unknown artist" %>
    <li class="library-media-list__item listen-card">
      <%= link_to library_item_server_connection_path(server_connection, item["Id"]), class: "library-media-list__art", data: { turbo_frame: "_top" } do %><%= image_tag artwork_path, alt: "", loading: "lazy" %><% end %>
      <div class="library-media-list__details"><%= link_to item["Name"], library_item_server_connection_path(server_connection, item["Id"]), data: { turbo_frame: "_top" } %><span><%= artist %></span></div>
      <div class="library-media-list__actions">
        <button type="button" class="favorites-track__favorite" data-controller="detail-favorite" data-detail-favorite-url-value="<%= favorite_server_connection_path(server_connection, item_id: item["Id"]) %>" data-detail-favorite-favorited-value="<%= item.dig("UserData", "IsFavorite") ? "true" : "false" %>" data-action="detail-favorite#toggle"><%= lucide_icon "heart", aria: { hidden: true } %></button>
        <button type="button" class="library-media-list__play listen-card__play" aria-label="Play <%= item["Name"] %>" data-action="player#replaceQueue" data-player-source-param="<%= audio_server_connection_path(server_connection, item["Id"]) %>" data-player-item-id-param="<%= item["Id"] %>" data-player-reporting-url-param="<%= playback_reports_server_connection_path(server_connection) %>" data-player-title-param="<%= item["Name"] %>" data-player-artist-param="<%= artist %>" data-player-artwork-param="<%= artwork_path %>" data-player-duration-param="<%= track_duration(item["RunTimeTicks"]) %>" data-player-radio-url-param="<%= radio_tracks_server_connection_path(server_connection, item["Id"]) %>" data-player-radio-eligible-param="true"><%= lucide_icon "play", aria: { hidden: true } %></button>
        <%= render "shared/card_options", item: item, artwork_path: artwork_path, server_connection: server_connection %>
      </div>
    </li>
  <% end %>
</ol>
