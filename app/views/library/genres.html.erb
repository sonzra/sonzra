<main class="redesign-library-page redesign-genres-page">
  <% if @result.success? %>
    <% genres = music_genre_names(@result.items) %>
    <header class="redesign-library-heading">
      <div>
        <p class="eyebrow">Your collection</p>
        <h1>Library</h1>
        <p>Everything on your server, beautifully organized.</p>
      </div>
    </header>

    <%= render "shared/redesign_library_tabs" %>

    <section class="redesign-library-content" aria-labelledby="genres-title">
      <div class="redesign-library-content__heading">
        <div><p class="eyebrow">Browse</p><h2 id="genres-title">All genres</h2></div>
        <%= render "shared/library_search", title: "Genres", path: library_genres_path, query: @query, genre: nil %>
      </div>
      <div class="redesign-genre-directory">
        <% genres.each_with_index do |genre_name, index| %>
          <div id="genre_tile_<%= genre_name.parameterize %>" class="genre-tile-item">
            <%= link_to library_albums_path(genre: genre_name), class: "redesign-genre-tile redesign-genre-tile--#{index % 6}", data: { turbo_frame: "_top" } do %>
              <span><%= genre_name %></span>
            <% end %>
            <% if @server_connection %>
              <%= button_to hidden_genres_path, params: { server_connection_id: @server_connection.id, name: genre_name }, method: :post, class: "genre-tile__hide-button", aria: { label: "Hide genre #{genre_name}" }, title: "Hide #{genre_name}" do %>
                <%= lucide_icon "eye-off", aria: { hidden: true } %>
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>
    </section>
  <% else %>
    <section class="listen-loading listen-loading--error"><h1>We couldn’t load your genres.</h1><p><%= @result.message %></p></section>
  <% end %>
</main>
