<ol class="library-media-list" aria-label="<%= @title %>">
  <% @result.items.each do |item| %>
    <% artwork_path = media_artwork_path(@server_connection, item) %>
    <% audio_item = item["Type"] == "Audio" %>
    <li class="library-media-list__item listen-card">
      <%= link_to library_item_server_connection_path(@server_connection, item["Id"]), class: "library-media-list__art", data: { turbo_frame: "_top" } do %><%= image_tag artwork_path, alt: "", loading: "lazy" %><% end %>
      <div class="library-media-list__details"><%= link_to item["Name"], library_item_server_connection_path(@server_connection, item["Id"]), data: { turbo_frame: "_top" } %><span><%= item["AlbumArtist"] || item["Artists"]&.join(", ") || item["Type"] %></span></div>
      <div class="library-media-list__actions">
        <%= render "shared/card_options", item: item, artwork_path: artwork_path, server_connection: @server_connection %>
        <% if audio_item %>
          <button type="button" aria-label="Play <%= item["Name"] %>" data-action="player#replaceQueue" data-player-source-param="<%= audio_server_connection_path(@server_connection, item["Id"]) %>" data-player-item-id-param="<%= item["Id"] %>" data-player-reporting-url-param="<%= playback_reports_server_connection_path(@server_connection) %>" data-player-title-param="<%= item["Name"] %>" data-player-artist-param="<%= item["AlbumArtist"] || item["Artists"]&.join(", ") || "Unknown artist" %>" data-player-artwork-param="<%= artwork_path %>" data-player-duration-param="<%= track_duration(item["RunTimeTicks"]) %>" data-player-radio-url-param="<%= radio_tracks_server_connection_path(@server_connection, item["Id"]) %>" data-player-radio-eligible-param="true"><%= lucide_icon "play", aria: { hidden: true } %></button>
          <button type="button" aria-label="Add <%= item["Name"] %> to queue" data-action="player#appendQueue" data-player-source-param="<%= audio_server_connection_path(@server_connection, item["Id"]) %>" data-player-item-id-param="<%= item["Id"] %>" data-player-reporting-url-param="<%= playback_reports_server_connection_path(@server_connection) %>" data-player-title-param="<%= item["Name"] %>" data-player-artist-param="<%= item["AlbumArtist"] || item["Artists"]&.join(", ") || "Unknown artist" %>" data-player-artwork-param="<%= artwork_path %>" data-player-duration-param="<%= track_duration(item["RunTimeTicks"]) %>" data-player-radio-url-param="<%= radio_tracks_server_connection_path(@server_connection, item["Id"]) %>" data-player-radio-eligible-param="true"><%= lucide_icon "list-music", aria: { hidden: true } %></button>
        <% else %>
          <button type="button" aria-label="Play <%= item["Name"] %>" data-action="player#replaceQueue" data-player-queue-url-param="<%= playback_queue_server_connection_path(@server_connection, item["Id"]) %>"><%= lucide_icon "play", aria: { hidden: true } %></button>
          <button type="button" aria-label="Add <%= item["Name"] %> to queue" data-action="player#appendQueue" data-player-queue-url-param="<%= playback_queue_server_connection_path(@server_connection, item["Id"]) %>"><%= lucide_icon "list-music", aria: { hidden: true } %></button>
        <% end %>
      </div>
    </li>
  <% end %>
</ol>
