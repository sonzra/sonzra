<div class="sonic-graph-canvas"
     data-controller="sonic-graph"
     data-sonic-graph-data-value="<%= { nodes: @nodes, edges: @edges }.to_json %>">

  <%# Loading Indicator Overlay %>
  <div data-sonic-graph-target="loader" class="sonic-graph-canvas__loader">
    <div class="sonic-graph-canvas__spinner"></div>
    <div class="sonic-graph-canvas__loader-text">Mapping your music galaxy...</div>
  </div>

  <%# Title Overlay (top-left) %>
  <div class="sonic-graph-canvas__title">
    <h1>Sonic Map</h1>
    <p><%= @nodes.size %> tracks</p>
  </div>

  <%# Search & Zoom Toolbar (top-right) %>
  <div class="sonic-graph-canvas__toolbar">
    <%= lucide_icon "search", aria: { hidden: true } %>
    <input type="text"
           data-sonic-graph-target="search"
           data-action="input->sonic-graph#onSearch"
           placeholder="Search tracks..."
           aria-label="Search tracks" />
    <button type="button"
            data-action="click->sonic-graph#resetZoom"
            class="icon-button"
            title="Reset View"
            aria-label="Reset View">
      <%= lucide_icon "rotate-ccw", aria: { hidden: true } %>
    </button>
  </div>

  <%# WebGL Canvas %>
  <div data-sonic-graph-target="container"
       class="sonic-graph-canvas__viewport"></div>

  <%# Detail Panel (bottom-right) %>
  <div data-sonic-graph-target="panel"
       class="sonic-graph-canvas__panel"></div>
</div>
