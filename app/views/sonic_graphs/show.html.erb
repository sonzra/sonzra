<div class="library-page container sonic-map-detail">
  <div class="library-page__header sonic-map-detail__header">
    <div>
      <button type="button" class="back-link back-link--compact" data-controller="history-back" data-action="click->history-back#go" aria-label="Back">
        <%= lucide_icon "arrow-left", aria: { hidden: true } %>
        <span>Back</span>
      </button>
      <h1 class="library-page__title">Sonic Music Map</h1>
      <p>
        A visual audio similarity network showing nearest musical neighbors for <strong><%= @center_item ? @center_item["Name"] : "Track" %></strong>
      </p>
    </div>
  </div>

  <div class="card sonic-map-detail__canvas"
       data-controller="sonic-graph"
       data-sonic-graph-data-value="<%= { center: @center_item ? { item_id: @center_item["Id"], title: @center_item["Name"], artist: @center_item["AlbumArtist"] || @center_item["Artists"]&.join(", ") || "Unknown artist", artwork: library_artwork_path(current_user.preferred_server_connection, @center_item) || "/brand/sonzra-mark.svg" } : nil, neighbors: @neighbors }.to_json %>">

    <div data-sonic-graph-target="container" class="sonic-map-detail__viewport"></div>

    <div data-sonic-graph-target="tooltip" class="sonic-map-detail__tooltip" hidden></div>
  </div>

  <% if @neighbors.present? %>
    <div class="sonic-map-detail__neighbors">
      <h2>Nearest Musical Neighbors</h2>
      <div class="sonic-map-detail__neighbor-grid">
        <% @neighbors.each do |neighbor| %>
          <div class="card sonic-map-detail__neighbor">
            <img src="<%= neighbor[:artwork] %>" alt="<%= neighbor[:title] %>" />
            <div class="sonic-map-detail__neighbor-info">
              <div class="sonic-map-detail__neighbor-title"><%= neighbor[:title] %></div>
              <div class="sonic-map-detail__neighbor-artist"><%= neighbor[:artist] %></div>
              <div class="sonic-map-detail__distance">Distance: <%= neighbor[:distance].round(2) %></div>
            </div>
            <%= link_to neighbor[:graph_url], class: "icon-button", title: "View Sonic Map", aria: { label: "View Sonic Map for #{neighbor[:title]}" } do %>
              <%= lucide_icon "orbit", aria: { hidden: true } %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
