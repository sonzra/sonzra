<main class="auth-page">
  <section class="auth-card">
    <%= link_to root_path, class: "auth-brand auth-brand--hero", aria: { label: "Sonzra" } do %><%= image_tag "/brand/sonzra-mark.svg", alt: "" %><span>sonzra</span><% end %>
    <p class="auth-sign-in-copy">Create an account to keep your Jellyfin connection and listening history private.</p>
    <%= render "shared/form_errors", record: @user %>
    <%= form_with model: @user, url: registration_path, class: "auth-form" do |form| %>
      <div class="field"><%= form.label :email_address, "Email address" %><%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "email" %></div>
      <div class="field"><%= form.label :password %><%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72 %></div>
      <div class="field"><%= form.label :password_confirmation %><%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72 %></div>
      <%= form.submit "Create account", class: "primary-button" %>
    <% end %>
    <p class="auth-card__footer">Already have an account? <%= link_to "Sign in", new_session_path %>.</p>
  </section>
</main>
