<!DOCTYPE html>
<html lang="en"
  <% if authenticated? %>
    data-controller="player"
    data-player-radio-enabled-value="<%= session.dig(:player_preferences, "radio_enabled") == true %>"
    data-player-preload-on-wifi-only-value="<%= session.dig(:player_preferences, "preload_on_wifi_only") == true %>"
    data-player-offline-value="<%= @offline_shell == true %>"
    data-player-preferences-url-value="<%= player_preferences_path %>"
  <% end %>>
  <head>
    <title><%= content_for(:title) || "Sonzra" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="theme-color" content="#16161f">
    <meta name="application-name" content="Sonzra">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32">
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="apple-touch-icon" href="/apple-touch-icon-ios.png?v=1">
    <%= stylesheet_link_tag "redesign", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <% if authenticated? %><body class="authenticated-body <%= "media-detail-body" if @media_detail_header %> <%= "offline-shell" if @offline_shell %> redesign" data-controller="card-options media-header offline-media transition <%= "offline-connection" if @offline_shell %>" data-offline-media-scope-value="<%= current_user.id %>"><% else %><body class="redesign"><% end %>
    <% if authenticated? %><%= render "shared/navigation", offline: @offline_shell == true %><%= render "shared/transition" %><%= turbo_stream_from [current_user, :notifications] %><% end %>
    <%= yield %>
    <% if authenticated? %><div id="connection_alerts" class="connection-alerts" data-turbo-permanent><% if connection_alert_server_connection %><%= render "shared/reconnect_banner", server_connection: connection_alert_server_connection %><% end %></div><%= render "shared/player" %><p id="player-feedback" class="listen-player__feedback" data-player-target="queueFeedback" data-turbo-permanent role="status" aria-live="polite" hidden></p><%= render "shared/player_queue" %><%= render "shared/card_options_sheet" %><%= render "shared/share_dialog" %><dialog id="reconnect-dialog" class="reconnect-dialog" data-controller="reconnect" data-reconnect-target="dialog" aria-modal="true" aria-labelledby="reconnect-title"><turbo-frame id="reconnect_modal"></turbo-frame></dialog><% end %>
  </body>
</html>
