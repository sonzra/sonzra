<!DOCTYPE html>
<html lang="en"
  <% if authenticated? %>
    data-controller="player"
    data-player-radio-enabled-value="<%= session.dig(:player_preferences, "radio_enabled") == true %>"
    data-player-offline-value="<%= @offline_shell == true %>"
    data-player-preferences-url-value="<%= player_preferences_path %>"
  <% end %>>
  <head>
    <title><%= content_for(:title) || "Sonzra" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="theme-color" content="#16161f">
    <meta name="application-name" content="Sonzra">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32">
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="apple-touch-icon" href="/apple-touch-icon-ios.png?v=1">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "auth", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "media_content", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "genre_links", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "player", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "queue", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "queue_overlay", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "queue_details", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "queue_controls", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "queue_history", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "lyrics", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "offline_downloads", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "main_player_layout", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "responsive", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "interaction", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "navigation", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "mobile_player", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "touch_cards", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "album_details", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "card_options", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "card_options_visibility", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "settings", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "minimized_player", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "mobile_queue_layout", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "music_shelf_pages", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <% if authenticated? %><body class="authenticated-body <%= "media-detail-body" if @media_detail_header %> <%= "offline-shell" if @offline_shell %>" data-controller="card-options media-header offline-media <%= "offline-connection" if @offline_shell %>" data-offline-media-scope-value="<%= current_user.id %>"><% else %><body><% end %>
    <% if authenticated? %><%= @offline_shell ? render("shared/navigation", offline: true) : render(@media_detail_header ? "shared/media_navigation" : "shared/navigation") %><% end %>
    <%= yield %>
    <% if authenticated? %><%= render "shared/player" %><p id="player-feedback" class="listen-player__feedback" data-player-target="queueFeedback" data-turbo-permanent role="status" aria-live="polite" hidden></p><%= render "shared/player_queue" %><%= render "shared/card_options_sheet" %><% end %>
  </body>
</html>
