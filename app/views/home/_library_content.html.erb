<section class="listen-welcome"><div><p class="listen-kicker">Welcome back, <%= content[:user_name] %></p><h1>What do you want to hear?</h1></div></section>
<section class="listen-genres" aria-label="Music genres"><div class="listen-genres__list"><% music_genre_names(content[:genres]).each do |genre_name| %><%= link_to genre_name, library_albums_path(genre: genre_name), class: "listen-genre", data: { turbo_frame: "_top" } %><% end %></div></section>
<% { "Recently played" => content[:recently_played], "Most played songs" => content[:most_played_songs] || [], "Recently added albums" => content[:recently_added_albums], "Most played albums" => content[:most_played_albums] || [], "Recently added audiobooks" => content[:recently_added_audiobooks] || [], "Recently added podcasts" => content[:recently_added_podcasts] || [], "Recently added artists" => content[:recently_added_artists] }.each do |title, items| %><%= render "shared/media_shelf", title: title, eyebrow: "From your library", items: items, server_connection: @server_connection %><% end %>
