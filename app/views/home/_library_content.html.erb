<section class="listen-welcome listen-welcome--compact"><div><p class="listen-kicker">Welcome back, <%= content[:user_name] %></p></div></section>
<% genres = music_genre_names(content[:genres]) %>
<% if genres.any? %>
  <section class="genre-explorer" aria-labelledby="genre-explorer-title">
    <div class="genre-explorer__heading"><h2 id="genre-explorer-title">Explore by genre</h2><%= link_to "Browse all", library_genres_path, class: "genre-explorer__all-link", data: { turbo_frame: "_top" } %></div>
    <div class="genre-explorer__grid"><% genres.first(4).each_with_index do |genre_name, index| %><%= link_to library_albums_path(genre: genre_name), class: "genre-tile genre-tile--#{index % 6}", data: { turbo_frame: "_top" } do %><span><%= genre_name %></span><%= lucide_icon "arrow-up-right", aria: { hidden: true } %><% end %><% end %><%= link_to library_genres_path, class: "genre-tile genre-tile--all", data: { turbo_frame: "_top" } do %><span>Browse all genres</span><%= lucide_icon "grid-2x2", aria: { hidden: true } %><% end %></div>
  </section>
<% end %>
<% { "Continue audiobooks" => content[:continue_audiobooks] || [], "Continue podcasts" => content[:continue_podcasts] || [] }.each do |title, items| %><%= render "shared/media_shelf", title: title, items: items, server_connection: @server_connection, resumable: true if items.any? %><% end %>
<% { "Recently played" => content[:recently_played], "Most played songs" => content[:most_played_songs] || [], "Recently added albums" => content[:recently_added_albums], "Most played albums" => content[:most_played_albums] || [], "Recently added audiobooks" => content[:recently_added_audiobooks] || [], "Recently added podcasts" => content[:recently_added_podcasts] || [], "Recently added artists" => content[:recently_added_artists] }.each do |title, items| %><%= render "shared/media_shelf", title: title, items: items, server_connection: @server_connection %><% end %>
