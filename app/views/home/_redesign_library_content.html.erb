<% continue_item = (content[:continue_podcasts] || []).first || (content[:continue_audiobooks] || []).first || (content[:recently_played] || []).first %>
<section class="redesign-home-heading">
  <div><p class="eyebrow">Your listening room</p><h1>Good evening, <%= current_user.email_address.split("@").first %>.</h1><p>Pick up where you left off or find something new.</p></div>
  <%= link_to root_path, class: "redesign-refresh", data: { turbo_frame: "home_content" } do %><%= lucide_icon "refresh-cw", aria: { hidden: true } %><span>Refresh library</span><% end %>
</section>
<% if continue_item %>
  <% artwork_path = media_artwork_path(@server_connection, continue_item); resumable = continue_item["Type"] == "AudioBook" || continue_item.dig("UserData", "PlaybackPositionTicks").to_i.positive? %>
  <article class="redesign-featured-media">
    <%= link_to library_item_server_connection_path(@server_connection, continue_item["Id"]), class: "redesign-featured-media__art", data: { turbo_frame: "_top" } do %><%= image_tag artwork_path, alt: "" %><% end %>
    <div class="redesign-featured-media__copy"><p class="eyebrow"><%= resumable ? "Continue listening" : "Recently played" %></p><h2><%= continue_item["Name"] %></h2><p><%= continue_item["AlbumArtist"] || continue_item["Artists"]&.join(", ") || continue_item["Type"] %></p><div class="redesign-featured-media__actions"><% if continue_item["Type"].in?([ "Audio", "AudioBook" ]) %><button type="button" class="primary-button" data-action="player#replaceQueue" data-player-source-param="<%= audio_server_connection_path(@server_connection, continue_item["Id"]) %>" data-player-item-id-param="<%= continue_item["Id"] %>" data-player-reporting-url-param="<%= playback_reports_server_connection_path(@server_connection) %>" data-player-title-param="<%= continue_item["Name"] %>" data-player-artist-param="<%= continue_item["AlbumArtist"] || continue_item["Artists"]&.join(", ") || "Unknown artist" %>" data-player-artwork-param="<%= artwork_path %>" data-player-duration-param="<%= track_duration(continue_item["RunTimeTicks"]) %>" data-player-start-position-param="<%= playback_position(continue_item) %>"<% if continue_item["Type"] == "Audio" %> data-player-radio-url-param="<%= radio_tracks_server_connection_path(@server_connection, continue_item["Id"]) %>" data-player-radio-eligible-param="true"<% end %>><%= lucide_icon "play", aria: { hidden: true } %><span><%= resumable ? "Resume" : "Play" %></span></button><% else %><button type="button" class="primary-button" data-action="player#replaceQueue" data-player-queue-url-param="<%= playback_queue_server_connection_path(@server_connection, continue_item["Id"]) %>"><%= lucide_icon "play", aria: { hidden: true } %><span>Play</span></button><% end %><%= link_to "Open", library_item_server_connection_path(@server_connection, continue_item["Id"]), class: "secondary-button", data: { turbo_frame: "_top" } %></div></div>
    <% if resumable %><div class="redesign-featured-media__progress"><span style="width:<%= playback_progress(continue_item) %>%"></span></div><% end %>
  </article>
<% end %>
<% genres = music_genre_names(content[:genres]) %>
<% if genres.any? %><section class="genre-explorer" aria-labelledby="genre-explorer-title"><div class="genre-explorer__heading"><p class="eyebrow">Explore</p><h2 id="genre-explorer-title">Browse by genre</h2></div><div class="genre-explorer__grid"><% genres.first(8).each_with_index do |genre_name, index| %><%= link_to library_albums_path(genre: genre_name), class: "genre-tile genre-tile--#{index % 6}", data: { turbo_frame: "_top" } do %><span><%= genre_name %></span><%= lucide_icon "arrow-up-right", aria: { hidden: true } %><% end %><% end %><%= link_to library_genres_path, class: "genre-tile genre-tile--all", data: { turbo_frame: "_top" } do %><span>All genres</span><%= lucide_icon "grid-2x2", aria: { hidden: true } %><% end %></div></section><% end %>
<%= render "shared/recommendation_shelf", collections: @recommendation_collections if @recommendation_collections.present? %>
<% { "Recently played" => [ content[:recently_played], library_recently_played_path ], "Most played songs" => [ content[:most_played_songs] || [], library_most_played_songs_path ], "Recently added albums" => [ content[:recently_added_albums], library_recently_added_albums_path ] }.each do |title, (items, see_all_path)| %><%= render "shared/media_shelf", title: title, items: items, server_connection: @server_connection, see_all_path: see_all_path if items.any? %><% end %>
<% { "Continue podcasts" => content[:continue_podcasts] || [], "Continue audiobooks" => content[:continue_audiobooks] || [] }.each do |title, items| %><%= render "shared/media_shelf", title: title, items: items, server_connection: @server_connection, resumable: true if items.any? %><% end %>
<% { "Most played albums" => content[:most_played_albums] || [], "Recently added audiobooks" => content[:recently_added_audiobooks] || [], "Recently added podcasts" => content[:recently_added_podcasts] || [], "Recently added artists" => content[:recently_added_artists] }.each do |title, items| %><%= render "shared/media_shelf", title: title, items: items, server_connection: @server_connection if items.any? %><% end %>
