# Optional: set this from your secret manager. If left blank, Sonzra generates
# and persists one in the mounted storage volume on its first boot.
SONZRA_SECRET_KEY=

# Required in production to authorize offline sonic graph analyzer and audio stream ingestion:
# ANALYZER_API_KEY=

# Optional: set to "true" to leave user registration open after admin setup, or "false" to enforce lock:
# SONZRA_OPEN_REGISTRATION=false
